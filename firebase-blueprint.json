{
  "entities": {
    "TelemetryPulse": {
      "title": "TelemetryPulse",
      "description": "Real-time QEL resonance lattice pulse and telemetry record",
      "type": "object",
      "properties": {
        "ip": {
          "type": "string",
          "description": "Source IP address of pulse",
          "maxLength": 64
        },
        "action": {
          "type": "string",
          "description": "Observed cyber action or vector",
          "maxLength": 64
        },
        "sig": {
          "type": "number",
          "description": "Calculated quantum harmonic signal 1-9"
        },
        "phase": {
          "type": "number",
          "description": "Lattice phase 0-11"
        },
        "entropy": {
          "type": "number",
          "description": "Total lattice entropy after pulse"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of pulse emission",
          "maxLength": 64
        },
        "hash": {
          "type": "string",
          "description": "Cryptographic witness hash signature",
          "maxLength": 128
        }
      },
      "required": ["ip", "action", "sig", "phase", "entropy", "timestamp"]
    },
    "SecurityAlert": {
      "title": "SecurityAlert",
      "description": "Automated cyber security alert generated by QEL anomaly detection",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Alert title",
          "maxLength": 200
        },
        "severity": {
          "type": "string",
          "description": "Severity level",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
        },
        "targetIp": {
          "type": "string",
          "description": "Target or attacker IP",
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "description": "Detailed incident description",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Incident response status",
          "enum": ["OPEN", "INVESTIGATING", "CONTAINED", "RESOLVED"]
        },
        "playbookExecuted": {
          "type": "string",
          "description": "Automated incident playbook trigger",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp alert was raised",
          "maxLength": 64
        }
      },
      "required": ["title", "severity", "targetIp", "status", "createdAt"]
    },
    "IncidentReport": {
      "title": "IncidentReport",
      "description": "Intelligence dossier exported to Google Docs and Google Drive",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of report",
          "maxLength": 200
        },
        "docId": {
          "type": "string",
          "description": "Google Docs document ID",
          "maxLength": 128
        },
        "driveFileId": {
          "type": "string",
          "description": "Google Drive file ID",
          "maxLength": 128
        },
        "docUrl": {
          "type": "string",
          "description": "URL to view doc",
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "description": "Summary of incident report",
          "maxLength": 2000
        },
        "authorEmail": {
          "type": "string",
          "description": "Email of user who created report",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["title", "docId", "createdAt"]
    }
  },
  "firestore": {
    "/telemetry/{pulseId}": {
      "schema": "TelemetryPulse",
      "description": "Lattice pulse stream"
    },
    "/alerts/{alertId}": {
      "schema": "SecurityAlert",
      "description": "Cyber security alerts and incidents"
    },
    "/reports/{reportId}": {
      "schema": "IncidentReport",
      "description": "Exported Google Workspace executive reports"
    }
  }
}
